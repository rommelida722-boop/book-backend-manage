{
  "name": "book-backend-manage",
  "version": "1.0.0",
  "description": "图书借阅系统后台管理 — Express + MySQL 重写版（原 Java 毕业考试机试题）",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "express",
    "mysql",
    "ejs",
    "图书借阅"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "mysql2": "^3.11.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/helpers/setup.js"
    ],
    "verbose": true
  }
}
