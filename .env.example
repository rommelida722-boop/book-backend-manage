# 复制本文件为 .env 后按你的环境填写（.env 已在 .gitignore 中，不会被提交）
# 复制命令：cp .env.example .env

# —— 数据库连接 ——
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=在此填入你的 MySQL root 密码
DB_NAME=book_manage

# —— 服务端口 ——
PORT=3000

# —— 业务常量 ——
# 原卷不实现登录功能，入库人固定为「系统管理员」（依据图-4 / 图-6 截图）
DEFAULT_CREATED_BY=系统管理员
# 每页显示条数，原卷要求每页 5 条
PAGE_SIZE=5
